  <Content>
    <Paragraph Type="New Act" id="3242f47b-ac10-4a81-bd2a-98e1176ebbce">
      <Text>ACT I</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="d5a668b3-9b12-407b-b7da-7e16ddef551e">
      <SceneProperties Length="3/8" Page="1" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="JOHN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="b110ccad-063f-4bc2-9574-b33e3f3a6f15"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Int. house - night</Text>
    </Paragraph>
    <Paragraph Type="Action" id="6c1b9ca6-2690-4767-9a3b-17b318c8d83e">
      <Text>This is an action line. More words follow here. </Text>
    </Paragraph>
    <Paragraph Type="Character" id="cc0c6df4-f920-4ade-8153-7550eafb1dcb">
      <Text>John</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="f72c8f2b-cb6b-414e-b207-6a4ab5bf915d">
      <Text>(happily)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="990dae45-5642-4723-aefe-c7061b12c049">
      <Text>Oh!? I am speaking now? This must be dialogue being written in a dialogue line. </Text>
    </Paragraph>
    <Paragraph Type="Action" id="9bd84737-c420-4007-9655-b3cd0fd8c25f">
      <Text>This is another action line. </Text>
    </Paragraph>
    <Paragraph Type="Transition" id="00d5f4bf-4293-41d0-a233-4fddf223b19e">
      <Text>CUT TO:</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="b9da63ab-398f-497b-b4bc-8a221539fb5b">
      <SceneProperties Length="3/8" Page="1" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="JOHN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="c92d29fc-92d2-4314-9502-6d4c7fc242c5"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIM">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No" id="a1822631-3128-4f8f-a097-0226c8c9aeaf"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Ext. House - Night</Text>
    </Paragraph>
    <Paragraph Type="Cast List" id="e7e4a467-f4dd-4503-96ff-be3fded1cd90">
      <Text>(JOHN, TIM)</Text>
    </Paragraph>
    <Paragraph Type="Action" id="37a05aa8-6641-4ece-8a39-212e222d7ef6">
      <Text>This is another action line. </Text>
    </Paragraph>
    <Paragraph Type="General" id="1e589b62-7b55-4cc3-9f6c-b62ce56a49c0">
      <Text>This is general text. </Text>
    </Paragraph>
    <Paragraph Type="Action" id="e05ea8c5-bef2-427d-9ca7-290854dd7215">
      <Text>More action here. </Text>
    </Paragraph>
    <Paragraph Type="Character" id="8666dc5d-cb98-4fd8-a86b-4632b6c7831d">
      <Text>John</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4293a5bd-05a9-4220-af48-54e05e98cfce">
      <Text>Am I talking again? </Text>
    </Paragraph>
    <Paragraph Type="Character" id="7b5a0d40-7377-4f26-8e3f-dc1461fc2726">
      <Text>Tim</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="378d95eb-9122-48ff-8415-44cc3e1eb688">
      <Text>I am responding. </Text>
    </Paragraph>
    <Paragraph Type="Shot" id="2e74d85c-6fc8-445b-9483-485a7364f848">
      <Text>Low-angle</Text>
    </Paragraph>
    <Paragraph Type="End of Act" id="7b2fa403-8ea0-4894-ac06-d140f3730288">
      <Text>END ACT I</Text>
    </Paragraph>
    <Paragraph Type="New Act" id="76b18c25-be22-4d65-a188-bdc41cf2c1cb">
      <Text>ACT II</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="1ae63d24-dc11-4f07-b708-588285a918a6">
      <SceneProperties Length="1/8" Page="2" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>Int. House - day</Text>
    </Paragraph>
    <Paragraph Type="Action" id="3552f8bc-5a17-4db9-8561-b33a1169d8f0">
      <Text>More action.</Text>
    </Paragraph>
