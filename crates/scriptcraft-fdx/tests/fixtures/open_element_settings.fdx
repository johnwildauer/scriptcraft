<?xml version="1.0" encoding="UTF-8"?>
<FinalDraft DocumentType="Script" Version="6">
  <ElementSettings Type="Lyrics">
    <FontSpec AdornmentStyle="2" Color="#87878F8FE0E0" Font="Avenir Next" RevisionID="7" Size="14" Style="Bold+Italic+Underline+AllCaps+HiddenText" />
    <ParagraphSpec Alignment="Full" FirstIndent="-0.25" Leading="1.3" LeftIndent="1.25" RightIndent="0.5" SpaceBefore="4.5" Spacing="2" StartsNewPage="Yes" Type="Lyrics" />
    <Behavior PaginateAs="Action" ReturnKey="action" TabKey="ACTION" Shortcut="" WinShortcut="Alt+L" />
    <Outline CanHide="Yes" Level="4" />
  </ElementSettings>
  <ElementSettings Type="Notations">
    <FontSpec Color="#000000000001" />
    <Behavior Shortcut="" WinShortcut="Alt+N" />
  </ElementSettings>
  <ElementSettings Type="action">
    <FontSpec AdornmentStyle="3" Color="#FfFfFfFfFfFf" Font="Georgia" RevisionID="5" Size="11" Style="Italic+HiddenText" />
    <ParagraphSpec Alignment="Right" FirstIndent="-0.10" Leading="Single" LeftIndent="1.75" RightIndent="6.75" SpaceBefore="3" Spacing="2" StartsNewPage="No" Type="action" />
    <Behavior PaginateAs="Action" ReturnKey="Action" TabKey="dialogue" Shortcut="" WinShortcut="Alt+A" />
    <Outline CanHide="No" Level="3" />
  </ElementSettings>
  <ElementSettings Type="Action">
    <FontSpec AdornmentStyle="1" Color="#000000000000" Font="Courier Final Draft" RevisionID="2" Size="12" Style="Bold" />
    <ParagraphSpec Alignment="Center" FirstIndent="0" Leading="Regular" LeftIndent="1" RightIndent="7.5" SpaceBefore="2" Spacing="1" StartsNewPage="No" Type="Action" />
    <Behavior PaginateAs="Action" ReturnKey="Action" TabKey="Character" Shortcut="2" WinShortcut="2" />
    <Outline CanHide="No" Level="1" />
  </ElementSettings>
  <ElementSettings Type="lyrics">
    <FontSpec Font="Book Antiqua" Size="10" Style="Italic" />
  </ElementSettings>
  <ElementSettings Type="Lyrics">
    <FontSpec Color="#123456789ABC" Font="Duplicate Must Not Win" Size="8" />
    <Behavior ReturnKey="Duplicate Target" Shortcut="Duplicate" />
  </ElementSettings>

  <TitlePage>
    <Paragraph Type="TitleFirst" Alignment="Center" id="open-title-direct">
      <Text>First </Text><Text Style="Bold">Title</Text>
      <VendorTitlePayload marker="retained">title payload</VendorTitlePayload>
      <UserParagraphData><VendorPayload marker="title-attachment" /></UserParagraphData>
    </Paragraph>
    <Content>
      <Paragraph Type="titlefirst" id="open-title-case"><Text>Case-distinct title</Text></Paragraph>
      <Paragraph Type="TitleContent" id="open-title-content"><Text>Typed content title</Text></Paragraph>
      <Paragraph id="open-title-typeless"><Text>Type-less title</Text></Paragraph>
      <Wrapper><Paragraph Type="OpaqueTitle" id="open-title-opaque"><Text>Opaque lookalike</Text></Paragraph></Wrapper>
    </Content>
  </TitlePage>
  <HeaderAndFooter>
    <Header><Paragraph Type="HeaderOnlyTitle" id="open-header-title"><Text>Header data</Text><VendorHeaderPayload marker="keep">header payload</VendorHeaderPayload></Paragraph></Header>
    <Footer><Paragraph Type="FooterOnlyTitle" id="open-footer-title"><Text>Footer data</Text><VendorFooterPayload marker="keep">footer payload</VendorFooterPayload></Paragraph></Footer>
  </HeaderAndFooter>

  <Content>
    <Paragraph Type="NoSettingsBody" Alignment="Center" id="open-body-general-derived" vendor-owner="preserve">
      <Text>General-derived body</Text>
      <SceneProperties><SceneNumber>not-semantic-for-arbitrary-type</SceneNumber></SceneProperties>
      <VendorBodyPayload marker="retained">body payload</VendorBodyPayload>
      <UserParagraphData><VendorPayload marker="body-attachment" /></UserParagraphData>
    </Paragraph>
    <Paragraph Type="UsedArbitraryUnconfigured" id="open-body-unconfigured"><Text>Used arbitrary type without settings</Text></Paragraph>
    <Paragraph Type="Dialogue" id="open-body-packaged-base"><Text>Packaged Dialogue base</Text></Paragraph>
    <Paragraph Type="Lyrics" id="open-body-lyrics"><Text Style="Bold">Lyrics text</Text></Paragraph>
    <Paragraph Type="lyrics" id="open-body-lower-lyrics"><Text>lowercase lyrics</Text></Paragraph>
    <Paragraph Type="action" id="open-body-lower-action"><Text>lowercase action</Text></Paragraph>
    <Paragraph Type="Action" id="open-body-action"><Text>uppercase Action</Text></Paragraph>
    <Paragraph id="open-body-missing-type"><Text>Missing Type stays opaque</Text></Paragraph>
    <Paragraph Type="" id="open-body-empty-type"><Text>Empty Type stays opaque</Text></Paragraph>
  </Content>
</FinalDraft>
