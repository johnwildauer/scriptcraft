  <ScriptNotes>
    <ScriptNote Color="#RRRRGGGGBBBB" DateModified="20250619T205550" DateTime="20250619T205533" Id="12" Name="" Range="0,0" Type="" WriterID="" WriterName="">
      <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="1" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
        <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">Use the Scene Citation element to label your scene.</Text>
      </Paragraph>
      <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="1" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
        <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">
Pressing Enter/Return will automatically take you to the Notations element.</Text>
      </Paragraph>
    </ScriptNote>
    <ScriptNote Color="#RRRRGGGGBBBB" DateModified="20250619T205621" DateTime="20250619T205608" Id="13" Name="" Range="8,8" Type="" WriterID="" WriterName="">
      <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="1" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
        <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">On the Title Page, include either your contact information or that of your representation -- not both.</Text>
      </Paragraph>
    </ScriptNote>
    <ScriptNote Color="#RRRRGGGGBBBB" DateModified="20250619T222252" DateTime="20250619T205638" Id="14" Name="" Range="130,130" Type="" WriterID="" WriterName="">
      <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="1" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
        <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">There are many ways to paginate your play, from the straight forward numerical sequence of 1, 2, 3 to an older format of I-2-16, (meaning Act 1, Scene 2, Page 16).</Text>
      </Paragraph>
    </ScriptNote>
    <ScriptNote Color="#RRRRGGGGBBBB" DateModified="20250619T205838" DateTime="20250619T205808" Id="15" Name="" Range="248,248" Type="" WriterID="" WriterName="">
      <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="1" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
        <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">This is a ScriptNote.</Text>
      </Paragraph>
    </ScriptNote>
    <ScriptNote Color="#RRRRGGGGBBBB" DateModified="20250619T205901" DateTime="20250619T205845" Id="16" Name="" Range="490,490" Type="" WriterID="" WriterName="">
      <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="1" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
        <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">Character names are placed in all caps to distinguish their actions.  After these initial directions, the character names return to regular formatting.</Text>
      </Paragraph>
    </ScriptNote>
    <ScriptNote Color="#RRRRGGGGBBBB" DateModified="20250619T205923" DateTime="20250619T205916" Id="17" Name="" Range="526,526" Type="" WriterID="" WriterName="">
      <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="1" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
        <Text AdornmentStyle="0" Font="Arial" RevisionID="0" Size="12" Style="">Use the Parenthetical element for stage action reliant on the proceeding dialogue.</Text>
      </Paragraph>
    </ScriptNote>
  </ScriptNotes>

